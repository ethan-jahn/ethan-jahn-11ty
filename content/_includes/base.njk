<button id="bgToggle" style="position: fixed; top: 10px; left: 10px; padding: 6px 12px; border: 1px solid black; background-color: grey; color: white; cursor: pointer;">bg on/off</button>
<script>
document.getElementById("bgToggle").addEventListener("click", function() {
    const current = localStorage.getItem("bgSolidMode") === "true";
    const next = !current;
    localStorage.setItem("bgSolidMode", next);
    if (next) {
        document.body.style.backgroundImage = "none";
        document.body.style.backgroundColor = "#ffffff";
    } else {
        location.reload();
    }
});
</script>

